<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera image behind the AR overlay, and photos for "Add a shortcut". -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Uploading shortcut submissions and pulling approved ones. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Outdoor leg: FusedLocation for the 40 m hand-off and ARCore Geospatial (docs/03 section 4). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- "Your shortcut ... is live." -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Explore map: the blue dot and the walk to the entrance. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- AR is optional: phones without ARCore still get text and map guidance. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />

    <queries>
        <!-- Lets us find the text to speech engine on Android 11 and newer. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".CampusMapsApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.CampusMaps">

        <!-- ARCore is optional, so the Play Store does not hide the app on phones without it. -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />

        <!-- ARCore Geospatial API key, from ARCORE_API_KEY in local.properties (empty until the owner adds one). -->
        <meta-data
            android:name="com.google.android.ar.API_KEY"
            android:value="${arcoreApiKey}" />

        <!-- Meta Wearables Device Access Toolkit (Developer Mode placeholders, see app/build.gradle.kts). -->
        <meta-data
            android:name="com.meta.wearable.mwdat.APPLICATION_ID"
            android:value="${mwdat_application_id}" />
        <meta-data
            android:name="com.meta.wearable.mwdat.CLIENT_TOKEN"
            android:value="${mwdat_client_token}" />

        <!-- Explore map. Filled from MAPS_API_KEY in local.properties; empty = blank tiles, straight-line route. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Portrait only (locked), per the design handoff. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Glasses setup helper (registration with the Meta AI app, glasses camera permission). The Meta AI app
             returns here through the campusmaps:// link. See glasses/GlassesSetupActivity.kt. Own task affinity, so neither it
             nor the Meta AI app it opens ends up in the CampusMaps task (qa-phone N7). -->
        <activity
            android:name=".glasses.GlassesSetupActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="com.campusmaps.glassessetup"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="campusmaps" />
            </intent-filter>
        </activity>

        <!-- Shares a file location with the camera app when taking shortcut photos. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
